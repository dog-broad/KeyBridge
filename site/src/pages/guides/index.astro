---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { withBase } from '../../lib/site';

const guides = (await getCollection('guides')).sort((a, b) => a.data.order - b.data.order);
---

<Base
  title="Guides"
  description="Plain-English guides to KeyBridge — what it is, how to pair your phone to your PC, using it as a media remote, whether it's safe, and fixing connection problems."
>
  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Guides</p>
        <h2>Everything, in plain English.</h2>
        <p>Written for people who have never used a tool like this. No jargon, step by step.</p>
      </div>
      <div class="guide-list">
        {
          guides.map((guide) => (
            <a class="guide-card" href={withBase(`guides/${guide.id}`)}>
              <div class="meta">
                <span class="tag">{guide.data.audience}</span>
                <span>{guide.data.minutes} min read</span>
              </div>
              <h3>{guide.data.title}</h3>
              <p>{guide.data.description}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Base>
