---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { SITE, LINKS, DOWNLOADS, FEATURES, STEPS, withBase } from '../lib/site';

import heroDevice from '../assets/hero-device.png';
import pair from '../assets/pair.png';
import deliver from '../assets/deliver.png';
import control from '../assets/control.png';
import themes from '../assets/themes.png';

const stepImages = { pair, deliver, control };

const guides = (await getCollection('guides'))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4);
---

<Base>
  <!-- Hero -->
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <p class="eyebrow">Phone → PC, over your Wi-Fi</p>
        <h1>Your phone is now your <span class="accent">PC keyboard</span>.</h1>
        <p class="lede">
          Scan a QR code to pair, then type, paste, fire hotkeys, and control media on your computer
          from across the room. No account. No cloud.
        </p>
        <div class="hero-actions">
          <a class="btn btn-primary" href={LINKS.appRelease} target="_blank" rel="noopener">
            Download the app
          </a>
          <a class="btn btn-ghost" href="#how">See how it works</a>
        </div>
        <div class="trust">
          <span><span class="dot"></span> Local network only</span>
          <span><span class="dot"></span> No account</span>
          <span><span class="dot"></span> Open source</span>
        </div>
      </div>
      <div class="hero-art">
        <Image
          src={heroDevice}
          alt="The KeyBridge app showing its key grid — modifiers, media, function keys, and shortcuts"
          loading="eager"
        />
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="section" id="how">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">How it works</p>
        <h2>Three steps from pocket to keyboard.</h2>
        <p>Pair once, then send anything. The PC confirms every keystroke landed before your phone calls it done.</p>
      </div>
      <div class="steps">
        {
          STEPS.map((step) => (
            <article class="step">
              <div>
                <span class="step-n">{step.n}</span>
                <h3>{step.title}</h3>
                <p>{step.body}</p>
              </div>
              <div class="step-media">
                <Image src={stepImages[step.image]} alt={step.alt} />
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Why it's different -->
  <section class="section band" id="why">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Why it’s built differently</p>
        <h2>Reliable and private by design.</h2>
        <p>Most "phone keyboard" apps fire input into the void and hope it lands. KeyBridge does not.</p>
      </div>
      <div class="features">
        {
          FEATURES.map((feature) => (
            <article class="feature">
              <div class="ico" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#46c6da" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M20 6 9 17l-5-5" />
                </svg>
              </div>
              <h3>{feature.title}</h3>
              <p>{feature.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Themes -->
  <section class="section">
    <div class="container themes-grid">
      <div>
        <p class="eyebrow">Looks right, light or dark</p>
        <h2 style="font-size: clamp(1.8rem, 4vw, 2.6rem); margin-top: 0.8rem;">
          Follows your system theme.
        </h2>
        <p style="color: var(--muted); margin-top: 1rem; font-size: 1.1rem;">
          KeyBridge matches your phone’s Light, Dark, or System setting — with the brand palette and
          full accessibility in both. Readable, high-contrast, screen-reader friendly.
        </p>
      </div>
      <Image src={themes} alt="KeyBridge settings shown in light and dark themes" />
    </div>
  </section>

  <!-- Guides preview -->
  <section class="section band">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">New here?</p>
        <h2>Plain-English guides.</h2>
        <p>No jargon. Start here if you have never used a tool like this before.</p>
      </div>
      <div class="guide-list">
        {
          guides.map((guide) => (
            <a class="guide-card" href={withBase(`guides/${guide.id}`)}>
              <div class="meta">
                <span class="tag">{guide.data.audience}</span>
                <span>{guide.data.minutes} min read</span>
              </div>
              <h3>{guide.data.title}</h3>
              <p>{guide.data.description}</p>
            </a>
          ))
        }
      </div>
      <div style="margin-top: 2rem;">
        <a class="btn btn-ghost" href={withBase('guides')}>Browse all guides</a>
      </div>
    </div>
  </section>

  <!-- Downloads -->
  <section class="section" id="download">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Get started</p>
        <h2>Two pieces, both free.</h2>
        <p>Install the host on your PC and the app on your phone. They version independently.</p>
      </div>
      <div class="downloads">
        {
          DOWNLOADS.map((dl) => (
            <article class="dl-card">
              <span class="platform">{dl.platform}</span>
              <h3>{dl.name}</h3>
              <p>{dl.blurb}</p>
              <div class="dl-actions">
                <a class="btn btn-primary" href={dl.href} target="_blank" rel="noopener">
                  {dl.cta}
                </a>
                <a class="src" href={dl.source} target="_blank" rel="noopener">Source</a>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section" style="padding-top: 0;">
    <div class="container">
      <div class="cta-band">
        <h2>Turn your phone into a keyboard tonight.</h2>
        <p>Two installs and a QR scan. Then type on your PC from the couch.</p>
        <div class="cta-actions">
          <a class="btn btn-primary" href={LINKS.appRelease} target="_blank" rel="noopener">
            Download the app
          </a>
          <a class="btn btn-ghost" href={LINKS.hostRelease} target="_blank" rel="noopener">
            Get the desktop host
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>
