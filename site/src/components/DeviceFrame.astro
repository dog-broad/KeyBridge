---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// A phone rendered as live DOM: a CSS metallic bezel wrapping the raw app
// screenshot as its screen. Frame proportions scale from --device-w, so one
// component serves the hero (large, angled) and the in-page steps (small).
interface Props {
  src: ImageMetadata;
  alt: string;
  width?: number;
  eager?: boolean;
  class?: string;
}
const { src, alt, width = 300, eager = false, class: cls = '' } = Astro.props;
---

<div class:list={['device', cls]} style={`--device-w:${width}px`}>
  <div class="device-screen">
    <Image src={src} alt={alt} width={760} loading={eager ? 'eager' : 'lazy'} />
  </div>
</div>
